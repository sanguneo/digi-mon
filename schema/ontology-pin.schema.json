{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digi-mon.local/schema/ontology-pin.schema.json",
  "title": "Pinned upstream ontology release",
  "type": "object",
  "additionalProperties": false,
  "required": ["taxonomyVersion", "files"],
  "properties": {
    "taxonomyVersion": { "type": "string", "minLength": 1 },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curriculum-standards.json", "topics.json", "dependencies.json", "clusters.json"],
      "properties": {
        "curriculum-standards.json": { "$ref": "#/$defs/file" },
        "topics.json": { "$ref": "#/$defs/file" },
        "dependencies.json": { "$ref": "#/$defs/file" },
        "clusters.json": { "$ref": "#/$defs/file" }
      }
    }
  },
  "$defs": { "file": { "type": "object", "required": ["sha256"], "properties": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } }
}
