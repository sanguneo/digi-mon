{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/digi-mon/learning-gate-request.schema.json",
  "title": "digi-mon stateless learning gate request",
  "type": "object",
  "required": ["schema", "policyRevision", "evidence", "target"],
  "properties": {
    "schema": { "const": "digi-mon/learning-gate-request@1" },
    "policyRevision": { "const": 1 },
    "evidence": {
      "oneOf": [
        { "$ref": "#/$defs/gradingEvidence" },
        { "$ref": "#/$defs/responseRecordEvidence" }
      ]
    },
    "target": { "$ref": "#/$defs/target" }
  },
  "$defs": {
    "standardCode": {
      "type": "string",
      "pattern": "^\\[[246][국수영][0-9]{2}-[0-9]{2}\\]$"
    },
    "standardCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 248,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/standardCode" }
    },
    "modes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "advanced",
          "literacy-foundations",
          "thinking-skills-v1"
        ]
      }
    },
    "target": {
      "type": "object",
      "required": ["subject", "codes", "modes", "count"],
      "properties": {
        "subject": { "enum": ["math", "korean", "english"] },
        "codes": { "$ref": "#/$defs/standardCodes" },
        "modes": { "$ref": "#/$defs/modes" },
        "count": { "type": "integer", "minimum": 1, "maximum": 100 },
        "advanceToCodes": { "$ref": "#/$defs/standardCodes" }
      },
      "additionalProperties": false
    },
    "standardAggregate": {
      "type": "object",
      "required": ["attempted", "correct", "accuracy"],
      "properties": {
        "attempted": { "type": "integer", "minimum": 1 },
        "correct": { "type": "integer", "minimum": 0 },
        "accuracy": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "gradingEvidence": {
      "type": "object",
      "required": [
        "source",
        "graded",
        "answered",
        "total",
        "manualScoringCount",
        "accuracy",
        "completionRate",
        "byStandard"
      ],
      "properties": {
        "source": { "const": "grading-result" },
        "graded": { "type": "integer", "minimum": 0 },
        "answered": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "manualScoringCount": { "type": "integer", "minimum": 0 },
        "accuracy": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "completionRate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "byStandard": {
          "type": "object",
          "propertyNames": {
            "pattern": "^\\[[246][국수영][0-9]{2}-[0-9]{2}\\]$"
          },
          "additionalProperties": { "$ref": "#/$defs/standardAggregate" }
        }
      },
      "additionalProperties": false
    },
    "responseRecordEvidence": {
      "type": "object",
      "required": ["source", "records"],
      "properties": {
        "source": { "const": "response-records" },
        "records": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "./grading-result.schema.json#/$defs/responseRecord"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
