{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/digi-mon/worksheet.schema.json",
  "title": "digi-mon deterministic worksheet",
  "type": "object",
  "required": [
    "schema",
    "engineVersion",
    "seed",
    "fingerprint",
    "title",
    "requested",
    "produced",
    "shortfall",
    "options",
    "modeSelection",
    "corpus",
    "standardsUsed",
    "difficultyHistogram",
    "items"
  ],
  "properties": {
    "schema": { "const": "digi-mon/worksheet@3" },
    "engineVersion": { "const": "digi-mon-engine@3" },
    "seed": { "type": "string" },
    "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "title": { "type": "string", "minLength": 1 },
    "requested": { "type": "integer", "minimum": 1 },
    "produced": { "type": "integer", "minimum": 0 },
    "shortfall": { "type": "integer", "minimum": 0 },
    "options": {
      "type": "object",
      "required": [
        "subject",
        "gradeBands",
        "domains",
        "codes",
        "count",
        "difficulty",
        "difficultyMix",
        "modes",
        "followLearningOrder"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "advanced",
              "literacy-foundations",
              "thinking-skills-v1"
            ]
          }
        }
      }
    },
    "modeSelection": {
      "type": "object",
      "required": ["schema", "resolved"],
      "properties": {
        "schema": { "const": "digi-mon/mode-selection@1" },
        "resolved": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "revision",
              "criterion",
              "label",
              "claimBoundary"
            ],
            "properties": {
              "id": {
                "enum": [
                  "advanced",
                  "literacy-foundations",
                  "thinking-skills-v1"
                ]
              },
              "revision": { "const": 1 },
              "criterion": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "claimBoundary": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "corpus": {
      "type": "object",
      "required": ["taxonomyVersion", "integrity"]
    },
    "standardsUsed": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "difficultyHistogram": { "type": "object" },
    "items": {
      "type": "array",
      "items": { "$ref": "./item.schema.json" }
    },
    "formSet": {
      "type": "object",
      "required": [
        "schema",
        "seed",
        "label",
        "formCount",
        "blueprintAttempt",
        "fingerprint"
      ],
      "properties": {
        "schema": { "const": "digi-mon/worksheet-form@1" },
        "seed": { "type": "string", "minLength": 1 },
        "label": { "enum": ["A", "B", "C", "D", "E", "F", "G", "H"] },
        "formCount": { "type": "integer", "minimum": 2, "maximum": 8 },
        "blueprintAttempt": { "type": "integer", "minimum": 0 },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
