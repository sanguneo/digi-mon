{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/digi-mon/worksheet-form-set.schema.json",
  "title": "digi-mon deterministic worksheet form set",
  "type": "object",
  "required": [
    "schema",
    "engineVersion",
    "seed",
    "formCount",
    "blueprintAttempt",
    "options",
    "blueprint",
    "forms",
    "fingerprint"
  ],
  "properties": {
    "schema": { "const": "digi-mon/worksheet-form-set@3" },
    "engineVersion": { "const": "digi-mon-engine@4" },
    "seed": { "type": "string", "minLength": 1 },
    "formCount": { "type": "integer", "minimum": 2, "maximum": 8 },
    "blueprintAttempt": { "type": "integer", "minimum": 0 },
    "options": {
      "$ref": "./worksheet.schema.json#/properties/options"
    },
    "blueprint": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "number",
          "standardCode",
          "generatorId",
          "difficulty"
        ],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "standardCode": {
            "type": "string",
            "pattern": "^\\[[246][국수영][0-9]{2}-[0-9]{2}\\]$"
          },
          "generatorId": { "type": "string", "minLength": 1 },
          "difficulty": { "enum": [1, 2, 3] }
        },
        "additionalProperties": false
      }
    },
    "forms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["label", "worksheet"],
        "properties": {
          "label": {
            "enum": ["A", "B", "C", "D", "E", "F", "G", "H"]
          },
          "worksheet": {
            "$ref": "./worksheet.schema.json"
          }
        },
        "additionalProperties": false
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
