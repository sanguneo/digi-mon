{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digi-mon.local/schema/coverage.schema.json",
  "title": "Standard and semantic coverage ledger",
  "type": "object",
  "required": ["schema", "coverageRatio", "covered", "uncovered", "manualOnly", "semanticCoverage"],
  "properties": {
    "schema": { "const": "digi-mon/coverage@2" },
    "coverageRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "covered": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "uncovered": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "manualOnly": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "semanticCoverage": { "$ref": "#/$defs/semantic" }
  },
  "$defs": {
    "semantic": {
      "type": "object",
      "required": [
        "contract",
        "assessmentTopicCount",
        "alignedAssessmentTopicCount",
        "candidateAlignedAssessmentTopicCount",
        "coverageRatio",
        "candidateCoverageRatio"
      ],
      "properties": {
        "contract": { "const": "digi-mon/generator-topic-alignment@1" },
        "assessmentTopicCount": { "type": "integer", "minimum": 0 },
        "alignedAssessmentTopicCount": { "type": "integer", "minimum": 0 },
        "candidateAlignedAssessmentTopicCount": { "type": "integer", "minimum": 0 },
        "coverageRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "candidateCoverageRatio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "entry": { "type": "object", "required": ["code", "generatorCount", "semanticCoverage"], "properties": { "semanticCoverage": { "$ref": "#/$defs/semantic" } } }
  }
}
