{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/digi-mon/item.schema.json",
  "title": "digi-mon canonical generated item",
  "type": "object",
  "required": [
    "id",
    "schema",
    "standardCode",
    "specId",
    "subject",
    "subjectKorean",
    "gradeBand",
    "domain",
    "generatorId",
    "skill",
    "learningSupport",
    "difficulty",
    "format",
    "scoring",
    "stem",
    "answer",
    "solution",
    "params",
    "dedupeKey"
  ],
  "properties": {
    "schema": { "const": "digi-mon/item@2" },
    "number": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
    "standardCode": { "type": "string", "pattern": "^\\[[246][국수영][0-9]{2}-[0-9]{2}\\]$" },
    "specId": { "type": "string", "minLength": 1 },
    "subject": { "enum": ["math", "korean", "english"] },
    "subjectKorean": { "enum": ["수학", "국어", "영어"] },
    "gradeBand": { "enum": ["1-2", "3-4", "5-6"] },
    "domain": { "type": "string", "minLength": 1 },
    "module": { "type": ["string", "null"] },
    "generatorId": { "type": "string", "minLength": 1 },
    "assessmentMappings": {
      "type": "array",
      "items": { "$ref": "./generator-topic-alignment.schema.json" }
    },
    "curriculum": {
      "type": ["object", "null"]
    },
    "skill": { "type": "string", "minLength": 1 },
    "learningSupport": {
      "$ref": "./learning-support.schema.json"
    },
    "difficulty": { "enum": [1, 2, 3] },
    "format": {
      "enum": [
        "short-answer",
        "fill-blank",
        "multiple-choice",
        "compare",
        "ordering",
        "write-expression",
        "construction"
      ]
    },
    "scoring": { "enum": ["auto", "manual"] },
    "stem": { "type": "string" },
    "instruction": { "type": "string" },
    "choices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["label", "text", "correct"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "correct": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "figure": { "type": "object" },
    "answer": {
      "type": "object",
      "required": ["display"],
      "properties": {
        "value": {},
        "display": { "type": "string", "minLength": 1 },
        "accepts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "rubric": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "solution": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "params": { "type": "object" },
    "dedupeKey": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "scoring": { "const": "auto" } },
        "required": ["scoring"]
      },
      "then": {
        "properties": {
          "answer": {
            "required": ["value", "display", "accepts"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "scoring": { "const": "manual" } },
        "required": ["scoring"]
      },
      "then": {
        "properties": {
          "answer": {
            "required": ["display", "rubric"]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
